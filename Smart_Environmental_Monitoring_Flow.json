  {
    "id": "sim1",
    "type": "function",
    "z": "tab1",
    "name": "Generate DHT22 readings",
    "func": "// Simulated DHT22 readings, representing an ESP32 publishing sensor data.\\nlet t = 24 + Math.random()*12;\\nlet h = 45 + Math.random()*35;\\nmsg.topic = 'environment/sensor';\\nmsg.payload = JSON.stringify({temperature:Number(t.toFixed(1)), humidity:Number(h.toFixed(1)), timestamp:new Date().toISOString(), source:'SIMULATED_ESP32_DHT22'});\\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 100,
