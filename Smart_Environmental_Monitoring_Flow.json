  {
    "id": "controller1",
    "type": "function",
    "z": "tab1",
    "name": "Automation + manual controller",
    "func": "// Input topics: environment/sensor, mode, fan_manual, led_manual\\nlet s = flow.get('sensor') || {temperature:25,humidity:50};\\nlet mode = flow.get('autoMode');\\nif (mode === undefined) mode = true;\\nlet fan = flow.get('fanState') || false;\\nlet led = flow.get('ledState') || false;\\nlet alert = 'Conditions normal';\\nif (msg.topic === 'environment/sensor') {\\n  let d = msg.payload; if (typeof d === 'string') { try { d=JSON.parse(d); } catch(e) { return null; } }\\n  s = d; flow.set('sensor',s);\\n} else if (msg.topic === 'mode') { mode = (msg.payload === true || msg.payload === 'true'); flow.set('autoMode',mode); }\\nelse if (msg.topic === 'fan_manual' && !mode) { fan = !!msg.payload; }\\nelse if (msg.topic === 'led_manual' && !mode) { led = !!msg.payload; }\\nif (mode) { fan = Number(s.temperature) > 30; led = Number(s.humidity) > 70; }\\nflow.set('fanState',fan); flow.set('ledState',led);\\nif (Number(s.temperature)>30) alert='HIGH TEMPERATURE: '+s.temperature+' \u00b0C';\\nif (Number(s.humidity)>70) alert += (alert==='Conditions normal'?'':' | ')+'HIGH HUMIDITY: '+s.humidity+' %';\\nif (alert==='Conditions normal') alert='Conditions normal';\\nlet a=[]; a[0]={payload:Number(s.temperature),timestamp:Date.now()}; a[1]={payload:Number(s.humidity),timestamp:Date.now()}; a[2]={payload:fan?'ON':'OFF'}; a[3]={payload:led?'ON':'OFF'}; a[4]={payload:alert};\\nif (msg.topic==='environment/sensor') a[5]={payload:new Date().toISOString()+','+s.temperature+','+s.humidity+','+(fan?'ON':'OFF')+','+(led?'ON':'OFF')+'\\\\n'};\\na[6]={topic:'environment/fan',payload:fan?'ON':'OFF'}; a[7]={topic:'environment/led',payload:led?'ON':'OFF'};\\nreturn a;",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "flow.set('autoMode',true);",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 300,
